{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PublishApplicationImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories",
        "ecr:PutLifecyclePolicy"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:386318011485:repository/ytgrabber-green-api-lambda",
        "arn:aws:ecr:us-east-1:386318011485:repository/ytgrabber-green-worker",
        "arn:aws:ecr:us-east-1:386318011485:repository/malika-editor"
      ]
    },
    {
      "Sid": "ReadLiveStackOutputs",
      "Effect": "Allow",
      "Action": "cloudformation:DescribeStacks",
      "Resource": "arn:aws:cloudformation:us-east-1:386318011485:stack/ytgrabber-green-serverless/*"
    },
    {
      "Sid": "DeployApiLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:us-east-1:386318011485:function:ytgrabber-green-api"
    },
    {
      "Sid": "ListDeployBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::videomaking-backup-386318011485",
        "arn:aws:s3:::ytgrabber-green-serverless-staticsitebucket-hbhp97rawcqc"
      ]
    },
    {
      "Sid": "DeployStaticSite",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::ytgrabber-green-serverless-staticsitebucket-hbhp97rawcqc/*"
    },
    {
      "Sid": "WriteNotebookAuthenticationState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::videomaking-backup-386318011485/ytgrabber-green/secrets/notebooklm/*"
    },
    {
      "Sid": "InvalidateTargetDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetDistribution"
      ],
      "Resource": "arn:aws:cloudfront::386318011485:distribution/E36OKTEHMEZQ4N"
    },
    {
      "Sid": "ManageWorkerJobDefinition",
      "Effect": "Allow",
      "Action": [
        "batch:DescribeJobDefinitions",
        "batch:DescribeJobQueues",
        "batch:RegisterJobDefinition",
        "batch:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassBatchRuntimeRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::386318011485:role/ytgrabber-green-batch-exec-role",
        "arn:aws:iam::386318011485:role/ytgrabber-green-worker-task-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
